{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
        "assets": [
      {
        "include": "**/*.ejs",
        "outDir": "dist/src/"
      }
    ],
    "watchAssets": true
  }
}
